{
  "name": "@sql-approval/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p ../shared/tsconfig.build.json && tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/src/cli.js",
    "test": "npm run build && node --test --test-isolation=none dist/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sql-approval/shared": "*",
    "mssql": "^12.7.16",
    "node-sql-parser": "^5.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0"
  }
}
