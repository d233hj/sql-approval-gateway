{
  "name": "sql-approval-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Human-approved, read-only SQL gateway (monorepo skeleton)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspace=@sql-approval/shared && npm run build --workspace=@sql-approval/core",
    "test": "npm run test --workspace=@sql-approval/core",
    "typecheck": "npm run typecheck --workspace=@sql-approval/shared && npm run typecheck --workspace=@sql-approval/core",
    "start": "npm run start --workspace=@sql-approval/core --",
    "start:core": "npm run start --workspace=@sql-approval/core --",
    "build:web": "npm run build --workspace=@sql-approval/web",
    "dist:portable": "npm run dist:portable --workspace=@sql-approval/desktop",
    "docker:build": "docker build -t sql-approval-gateway:0.1.0 .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "pack:check": "npm pack --dry-run -w @sql-approval/core && npm pack --dry-run -w @sql-approval/mcp && npm pack --dry-run -w @sql-approval/dsh",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/windows/install-autostart.ps1",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/windows/status.ps1",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/windows/uninstall-autostart.ps1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "url": "https://github.com/d233hj/sql-approval-gateway.git",
    "type": "git"
  },
  "license": "MIT"
}
